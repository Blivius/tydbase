{
  "components": {
    "schemas": {
      "Descriptor": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/schemas/Descriptor.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "defaultPort": {
            "description": "Standard TCP port (0 for embedded/file engines).",
            "format": "int64",
            "type": "integer"
          },
          "id": {
            "description": "Stable engine identifier (e.g. postgres, mongodb, redis).",
            "type": "string"
          },
          "name": {
            "description": "Human-readable database engine name.",
            "type": "string"
          },
          "paradigm": {
            "description": "Primary data paradigm.",
            "enum": [
              "sql",
              "document",
              "kv",
              "vector"
            ],
            "type": "string"
          },
          "status": {
            "description": "Driver implementation tier.",
            "enum": [
              "tier1",
              "planned"
            ],
            "type": "string"
          },
          "supportsReadTx": {
            "description": "Whether read-only transactions are enforced natively.",
            "type": "boolean"
          },
          "supportsRelay": {
            "description": "Whether private VPC/localhost relay tunneling is supported.",
            "type": "boolean"
          },
          "supportsVector": {
            "description": "Whether native vector similarity indexing is supported.",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "paradigm",
          "defaultPort",
          "supportsRelay",
          "supportsReadTx",
          "supportsVector",
          "status"
        ],
        "type": "object"
      },
      "EnginesOutputBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/schemas/EnginesOutputBody.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "engines": {
            "description": "Supported and planned database engines.",
            "items": {
              "$ref": "#/components/schemas/Descriptor"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "total": {
            "description": "Total number of engines in catalog.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "engines",
          "total"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/schemas/ErrorModel.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "HealthOutputBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/schemas/HealthOutputBody.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "env": {
            "description": "Runtime environment.",
            "examples": [
              "development"
            ],
            "type": "string"
          },
          "goVersion": {
            "description": "Go runtime version.",
            "examples": [
              "go1.27.4"
            ],
            "type": "string"
          },
          "paradigms": {
            "description": "Supported database paradigms.",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "service": {
            "description": "Service identifier.",
            "examples": [
              "tydbase-api"
            ],
            "type": "string"
          },
          "status": {
            "description": "Overall API liveness status.",
            "examples": [
              "ok"
            ],
            "type": "string"
          },
          "timestamp": {
            "description": "UTC RFC3339 timestamp.",
            "type": "string"
          },
          "version": {
            "description": "Build version.",
            "examples": [
              "0.1.0"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "env",
          "goVersion",
          "paradigms",
          "timestamp"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Open-source multiplayer database workspace and governed MCP control plane API.",
    "license": {
      "name": "Apache-2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0"
    },
    "title": "TydBase API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/engines": {
      "get": {
        "description": "Returns the unified 4-paradigm engine catalog (SQL, Document, Key-Value, Vector).",
        "operationId": "list-engines",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnginesOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "List supported database engines",
        "tags": [
          "Engines"
        ]
      }
    },
    "/api/v1/engines/{id}": {
      "get": {
        "description": "Returns capabilities and metadata for a single database engine by ID.",
        "operationId": "get-engine",
        "parameters": [
          {
            "description": "Stable engine identifier (e.g. postgres, mongodb, redis).",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "Stable engine identifier (e.g. postgres, mongodb, redis).",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Descriptor"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Get a database engine descriptor",
        "tags": [
          "Engines"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "description": "Returns service liveness, version, Go runtime, and supported database paradigms.",
        "operationId": "get-health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Check API health",
        "tags": [
          "System"
        ]
      }
    }
  }
}
