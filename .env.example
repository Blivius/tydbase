# Engine (tydbase server). Copy to .env for docker compose; never commit .env.
# The marketing site's variables (Resend, site URL) live in apps/site/.env.example.

# HTTP listen port inside the container (PORT is honoured as a fallback).
TYDBASE_PORT=8080

# development | production
TYDBASE_ENV=development

# Allowed browser origin for the API until the web app is served same-origin (P1 · M4).
TYDBASE_CORS_ORIGIN=http://localhost:3000

# Holds tydbase.db (metadata) and master.key. Default: the OS user config dir + /tydbase
# (macOS ~/Library/Application Support/tydbase, Linux ~/.config/tydbase). The Docker image uses /data.
# TYDBASE_DATA_DIR=

# Master key that encrypts stored DB passwords: base64 of 32 random bytes (openssl rand -base64 32).
# Leave unset to auto-generate <data dir>/master.key on first boot. Losing it loses every stored secret.
# TYDBASE_MASTER_KEY=
