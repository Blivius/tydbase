{
  "name": "tydbase",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "7.0.2",
      "@types/bun": "1.4.5",
      "@types/node": "26.6.6",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "react": "19.3.1",
      "react-dom": "19.3.1"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "bun test",
    "sdk:gen": "bun run --cwd packages/sdk generate",
    "prepare": "husky",
    "lint": "oxlint --type-aware --config .oxlintrc.json apps packages",
    "fmt": "oxfmt --config .oxfmtrc.json --write apps packages",
    "fmt:check": "oxfmt --config .oxfmtrc.json --check apps packages",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/bun": "catalog:",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "turbo": "2.11.13",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=26.13.1"
  },
  "packageManager": "bun@1.4.4"
}
