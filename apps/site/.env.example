# Resend API key from your Resend account (when unset, signups save locally to .waitlist-dev.json)
RESEND_API_KEY=

# Optional Resend Audience ID (if omitted, uses Resend's global /contacts endpoint)
RESEND_AUDIENCE_ID=

# Optional verified sender address for waitlist confirmation emails (e.g. TydBase <beta@blivius.com>)
RESEND_FROM_EMAIL=

# Optional internal notification address when a new beta user signs up
RESEND_NOTIFY_EMAIL=

# Public canonical URL
NEXT_PUBLIC_SITE_URL=https://tydbase.blivius.com
