# Resend API key with FULL ACCESS (a sending-only key cannot create contacts).
# Unset in development: signups go to .waitlist-dev.json. Unset in production: signups get a 503.
RESEND_API_KEY=

# Sender for the confirmation and notify emails, on a domain verified in Resend.
# Empty = contacts are saved but no email is sent (the server logs a warning).
RESEND_FROM_EMAIL="TydBase <beta@notifications.tydbase.blivius.com>"

# Inbox that gets a "new signup" email. Also shown on /privacy as the privacy contact.
RESEND_NOTIFY_EMAIL=

# Where replies to the confirmation email go (the sender address has no inbox).
RESEND_REPLY_TO=

# Optional Resend Segment ID: each signup joins it (contacts are global either way).
RESEND_SEGMENT_ID=

# Answers are stored as contact properties. Create these once in Resend → Contacts → Properties,
# all of type string: role, databases, ai_tools

# Public canonical URL
NEXT_PUBLIC_SITE_URL=https://tydbase.blivius.com
